{
  "name": "queueglass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "audit:claims": "node scripts/claim-scan.mjs",
    "audit:secrets": "node scripts/secret-scan.mjs",
    "verify": "npm run audit:claims && npm run audit:secrets && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "8.5.31",
    "sharp": "0.35.5"
  }
}
